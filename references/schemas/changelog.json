{
  "$comment": "變更日誌內容契約。每條變更僅一字描述，動詞開頭、使用者導向，禁用內部術語。破壞性變更永遠置頂並附遷移路徑。單次版本包含 4–8 條紀錄。",
  "type": "object",
  "required": ["product", "versions"],
  "properties": {
    "product": { "type": "string", "minLength": 1, "maxLength": 60 },
    "versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["version", "date"],
        "properties": {
          "version": { "type": "string", "minLength": 1, "maxLength": 30 },
          "date": { "type": "string", "minLength": 4, "maxLength": 30 },
          "summary": {
            "$comment": "版本概述段落，簡述本版更新重點。",
            "type": "string",
            "minLength": 4,
            "maxLength": 300
          },
          "breaking": {
            "$comment": "破壞性變更，每條列出改變與遷移說明。",
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["change", "migration"],
              "properties": {
                "change": { "type": "string", "minLength": 6, "maxLength": 200 },
                "migration": { "type": "string", "minLength": 6, "maxLength": 200 }
              }
            }
          },
          "features": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string", "minLength": 6, "maxLength": 200 }
          },
          "fixes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string", "minLength": 6, "maxLength": 200 }
          }
        }
      }
    }
  }
}
