{
  "$comment": "單頁方案內容契約。讀者要在 30 秒內抓到重點。字數目標：繁中 400–600 字。關鍵指標是核心主張而非補充證據，開頭不寫無意義場面話。",
  "type": "object",
  "required": ["title", "subtitle", "metrics", "argument", "evidence", "next_step"],
  "properties": {
    "title": { "type": "string", "minLength": 2, "maxLength": 60 },
    "subtitle": { "type": "string", "minLength": 2, "maxLength": 100 },
    "metrics": {
      "$comment": "3–4 張卡片，數字在前。卡片若講不出故事，就是指標選錯了。",
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["value", "label"],
        "properties": {
          "value": { "type": "string", "minLength": 1, "maxLength": 20 },
          "label": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      }
    },
    "argument": {
      "$comment": "1–2 段核心論點。首句承載單一最尖銳主張，而非背景交代。",
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "type": "string", "minLength": 20, "maxLength": 400 }
    },
    "evidence": {
      "$comment": "每條列舉皆為證據，非重複論點：事實 + 數據 + 影響。",
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 10, "maxLength": 220 }
    },
    "next_step": { "type": "string", "minLength": 4, "maxLength": 160 },
    "contact": { "type": "string", "maxLength": 120 }
  }
}
