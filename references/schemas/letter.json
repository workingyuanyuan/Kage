{
  "$comment": "正式信件內容契約。單頁篇幅，絕不上看第二頁。第一段一字說明事由；末段給出明確請求或下一步；中間為線性推演之證據，一段僅說明一事。字數目標：繁中 300–500 字。",
  "type": "object",
  "required": ["sender", "date", "recipient", "salutation", "paragraphs", "signoff", "signature"],
  "properties": {
    "sender": { "type": "string", "minLength": 2, "maxLength": 160 },
    "date": { "type": "string", "minLength": 4, "maxLength": 30 },
    "recipient": { "type": "string", "minLength": 2, "maxLength": 160 },
    "salutation": { "type": "string", "minLength": 2, "maxLength": 60 },
    "subject": { "type": "string", "minLength": 2, "maxLength": 120 },
    "paragraphs": {
      "$comment": "3–5 段正文。語氣依情境校準：公文商務克制精準、建議熱切具體、提案價值優先。",
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 20, "maxLength": 500 }
    },
    "signoff": {
      "$comment": "符合正式禮儀，如 順頌商祺 / 此致 敬禮。",
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "signature": { "type": "string", "minLength": 1, "maxLength": 60 },
    "enclosures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 2, "maxLength": 120 }
    }
  }
}
