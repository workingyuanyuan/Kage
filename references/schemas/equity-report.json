{
  "$comment": "個股研究報告內容契約。首頁顯眼處給出異見感知（市場尚未定價的關鍵變化），每個論點皆須連結至可量化的財務影響。語氣專業嚴謹：使用『我們估計』，禁用宣傳口號。",
  "type": "object",
  "required": ["company", "rating", "thesis", "valuation", "catalysts", "risks"],
  "properties": {
    "company": { "type": "string", "minLength": 1, "maxLength": 60 },
    "ticker": { "type": "string", "minLength": 1, "maxLength": 20 },
    "rating": { "type": "string", "minLength": 2, "maxLength": 20 },
    "price_target": { "type": "string", "minLength": 1, "maxLength": 30 },
    "thesis": {
      "$comment": "首頁上半部 3–5 條關鍵驅動因子，每條皆有數據或來源支持。",
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 20, "maxLength": 300 }
    },
    "valuation": {
      "$comment": "至少兩種估值方法與敏感度區間。單一方法估值為不專業表現。",
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["method", "result", "sensitivity"],
        "properties": {
          "method": { "type": "string", "minLength": 2, "maxLength": 60 },
          "result": { "type": "string", "minLength": 2, "maxLength": 120 },
          "sensitivity": { "type": "string", "minLength": 4, "maxLength": 200 }
        }
      }
    },
    "catalysts": {
      "$comment": "每項催化劑皆須有預期日期與影響幅度。",
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["event", "date", "magnitude"],
        "properties": {
          "event": { "type": "string", "minLength": 4, "maxLength": 160 },
          "date": { "type": "string", "minLength": 4, "maxLength": 30 },
          "magnitude": { "type": "string", "minLength": 2, "maxLength": 120 }
        }
      }
    },
    "risks": {
      "$comment": "量化並連結至模型之風險，非泛泛免責聲明。在反駁反方觀點前先承認其存在。",
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["risk", "impact"],
        "properties": {
          "risk": { "type": "string", "minLength": 6, "maxLength": 200 },
          "impact": { "type": "string", "minLength": 4, "maxLength": 200 }
        }
      }
    },
    "financials": {
      "$comment": "財務預測數據表。區分 GAAP 與 non-GAAP，標註一次性項目。",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["label", "values"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 60 },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": { "type": "string", "minLength": 1, "maxLength": 30 }
          }
        }
      }
    }
  }
}
