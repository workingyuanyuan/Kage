{
  "$comment": "長篇文件內容契約（6–15 頁）。每章皆以通過『那又怎樣』檢驗之主張段落開頭。每段至少包含一項數據，零數字段落屬純主觀意見應極罕見。字數目標：繁中 3000–8000 字。",
  "type": "object",
  "required": ["title", "author", "date", "summary", "chapters"],
  "properties": {
    "title": { "type": "string", "minLength": 2, "maxLength": 80 },
    "subtitle": { "type": "string", "minLength": 1, "maxLength": 120 },
    "author": { "type": "string", "minLength": 1, "maxLength": 60 },
    "date": { "type": "string", "minLength": 4, "maxLength": 30 },
    "summary": {
      "$comment": "執行摘要：一頁以內加上 3–5 條核心要點。",
      "type": "object",
      "required": ["claim", "takeaways"],
      "properties": {
        "claim": { "type": "string", "minLength": 40, "maxLength": 600 },
        "takeaways": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 10, "maxLength": 220 }
        }
      }
    },
    "chapters": {
      "$comment": "每章獨立成篇：主張、證據、結論。篇幅過小者應併入相鄰章節。",
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["title", "claim", "paragraphs"],
        "properties": {
          "title": { "type": "string", "minLength": 2, "maxLength": 80 },
          "claim": {
            "$comment": "2–3 句總結該章論點。",
            "type": "string",
            "minLength": 20,
            "maxLength": 400
          },
          "paragraphs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "items": { "type": "string", "minLength": 40, "maxLength": 800 }
          },
          "figure": {
            "$comment": "每頁至多一張圖表。圖說寫洞察而非資料範圍。",
            "type": "object",
            "required": ["kind", "caption"],
            "properties": {
              "kind": { "type": "string", "minLength": 2, "maxLength": 40 },
              "caption": { "type": "string", "minLength": 6, "maxLength": 200 }
            }
          }
        }
      }
    },
    "references": {
      "$comment": "資料來源引註，便於讀者區分事實、判斷與推論。",
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "type": "string", "minLength": 4, "maxLength": 240 }
    }
  }
}
